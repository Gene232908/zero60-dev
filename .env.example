# =============================================================================
# ZeroSixtyThree — environment variables
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must NEVER be
# committed. On Vercel these go in Project Settings → Environment Variables.
#
# This file ships variable NAMES only. Every value here is intentionally blank.
# =============================================================================

# --- Firebase (client / browser) --------------------------------------------
# A Firebase web config is not a secret — it identifies the project, it does not
# authorise access. What protects the data is firestore.rules. Kept in env so the
# same build can point at a sandbox or at production.
# BLOCKER B10a: confirm whether project `zero60dev` is the client-owned project
# or a developer sandbox to be replaced before launch.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server) -------------------------------------------------
# THESE ARE SECRET. The private key grants full read/write on the database and
# bypasses every security rule. Never expose them to the browser, never commit.
# Generate: Firebase console → Project settings → Service accounts →
#           Generate new private key.
# Paste the private key as a single line with \n escapes.
# BLOCKER B10b: not yet supplied.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- SMTP for Nodemailer ------------------------------------------------------
# THESE ARE SECRET. Used to send the new-enquiry notification.
# Port 465 = implicit TLS, port 587 = STARTTLS.
# BLOCKER B11: not yet supplied by the client.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Notifications ------------------------------------------------------------
# The mailbox that receives every new enquiry.
# BLOCKER B12: not yet supplied by the client.
INQUIRY_NOTIFICATION_EMAIL=

# --- Site URL (Milestone 4) ---------------------------------------------------
# Canonical origin, used as metadataBase for the share card and canonical links.
# Not a secret. Leave BLANK on Vercel: the deployment's own URL is detected, so
# preview builds describe themselves instead of claiming to be production.
# Set explicitly only to override, e.g. https://zerosixtythree.com
NEXT_PUBLIC_SITE_URL=

# --- Meta Pixel (Milestone 4) -------------------------------------------------
# Marco's lead tracking. Not a secret — a Pixel ID is public by design, it ships
# in the page source of every site that uses one.
# Leave blank and the pixel does not render at all: no script, no requests to
# Meta. Set it and PageView + Lead start reporting with no code change.
# BLOCKER B15: needs Meta Business access, not yet granted.
NEXT_PUBLIC_META_PIXEL_ID=
